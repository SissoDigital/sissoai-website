# Sisso AI Website — example environment variables.
# Copy this file to `.env.local` and fill in real values for local development.
# Production values are configured in Vercel project settings.

# Make.com webhook URL that receives contact form submissions.
# Payload shape is defined in PRD §5.4. Leave empty in dev to use the
# "not configured" fallback (form shows the standard error toast).
MAKE_WEBHOOK_URL=

# WhatsApp number in international format, digits only (e.g. 14155551234).
# The app normalizes input — pluses, spaces, dashes, and parens are stripped.
# If empty, the floating WhatsApp button and the CTA-section WhatsApp link
# are hidden entirely (no broken wa.me links are rendered).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cal.com link path (e.g. cal.com/sisso-ai/30min).
# If empty, the embed renders the styled fallback link button only.
NEXT_PUBLIC_CAL_LINK=

# Canonical site URL used for metadata, Open Graph, sitemap, and robots.
# Example: https://sissoai.com
NEXT_PUBLIC_SITE_URL=

# Optional path to a real founder headshot inside /public (e.g. /images/sisso.jpg).
# If empty, the About section renders a local styled monogram placeholder.
# Replace by dropping the file in /public and setting this to its path.
NEXT_PUBLIC_FOUNDER_IMAGE=
